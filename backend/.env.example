# MongoDB Atlas connection string. {MONGODB_PASSWORD} is replaced with MONGODB_PASSWORD at runtime.
MONGODB_URL=mongodb+srv://<user>:{MONGODB_PASSWORD}@<cluster>.mongodb.net/
MONGODB_PASSWORD=
MONGODB_DB_NAME=clashofcode

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# townhall code-execution service (../townhall). TOWNHALL_TOKEN = townhall's AUTH_TOKEN.
TOWNHALL_URL=http://localhost:3000
TOWNHALL_TOKEN=dev-token
